#!/bin/bash
set -euo pipefail

PACKAGE_NAME="canbus-core-binding-rs"
COVERAGE=no
MAIN_SO_PATH="/usr/redpesk/canbus-core-binding-rs/lib"
EXAMPLES_SO_PATH="/usr/libexec/redtest/canbus-core-binding-rs/lib"

export LD_LIBRARY_PATH="${MAIN_SO_PATH}:${EXAMPLES_SO_PATH}:${LD_LIBRARY_PATH:-}"

echo "--- Start canbus-core-binding-rs RedTest ---"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(dirname "${SCRIPT_DIR}")

LOG_DIR="${LOG_DIR:-/var/log/redtest/${PACKAGE_NAME}}"
if ! mkdir -p "${LOG_DIR}" 2>/dev/null || [[ ! -w "${LOG_DIR}" ]]; then
  LOG_DIR="$(pwd)/logs"
  mkdir -p "${LOG_DIR}"
fi
export LOG_DIR

COVERAGE_DIR="${COVERAGE_DIR:-${LOG_DIR}/coverage}"

if [[ "${COVERAGE}" == "yes" ]]; then
  rm -rf "${COVERAGE_DIR}"
  mkdir -p "${COVERAGE_DIR}"

  export LLVM_PROFILE_FILE="${COVERAGE_DIR}/%p-%m.profraw"
  export LLVM_PROFDATA=/usr/bin/llvm-profdata
  export LLVM_COV=/usr/bin/llvm-cov
fi

RUN_SH="${SCRIPT_DIR}/run.sh"
if [[ ! -f "${RUN_SH}" ]]; then
  echo "${RUN_SH}: not found, using local directory instead"
  RUN_SH="${SCRIPT_DIR}/../tests/run.sh"
  if [[ ! -f "${RUN_SH}" ]]; then
    echo "${RUN_SH}: not found"
    exit 1
  fi
fi

echo "Running tests with ${RUN_SH}"
"${RUN_SH}" \
  --setup_vcan \
  --cleanup_vcan \
  --log_dir "${LOG_DIR}" \
  "$@"

##########################
# Coverage report section
##########################

if [[ "${COVERAGE}" == "yes" ]]; then
  echo "--- Generate LLVM coverage report ---"

  shopt -s nullglob
  PROFRAW_FILES=("${COVERAGE_DIR}"/*.profraw)
  shopt -u nullglob

  if [[ ${#PROFRAW_FILES[@]} -eq 0 ]]; then
    echo "ERROR: no LLVM profile data generated in ${COVERAGE_DIR}" >&2
    exit 1
  fi

  echo "Merging .profraw files into ${COVERAGE_DIR}/merged.profdata"
  "${LLVM_PROFDATA}" merge -sparse "${PROFRAW_FILES[@]}" \
    -o "${COVERAGE_DIR}/merged.profdata"

  if [[ ! -f "${MAIN_SO_PATH}/libafb_sockcan.so" ]]; then
    echo "${MAIN_SO_PATH}/libafb_sockcan.so: not found, using local release directory instead"
    MAIN_SO_PATH="${ROOT_DIR}/target/release"
    if [[ ! -f "${MAIN_SO_PATH}/libafb_sockcan.so" ]]; then
      echo "${MAIN_SO_PATH}/libafb_sockcan.so: not found, using local debug directory instead"
      MAIN_SO_PATH="${ROOT_DIR}/target/debug"
      if [[ ! -f "${MAIN_SO_PATH}/libafb_sockcan.so" ]]; then
        echo "${MAIN_SO_PATH}/libafb_sockcan.so: not found, coverage impossible"
        exit 1
      fi
    fi
  fi

  if [[ ! -f "${EXAMPLES_SO_PATH}/libafb_model3.so" ]]; then
    echo "${EXAMPLES_SO_PATH}/libafb_model3.so: not found, using local release directory instead"
    EXAMPLES_SO_PATH="${ROOT_DIR}/target/release"
    if [[ ! -f "${EXAMPLES_SO_PATH}/libafb_model3.so" ]]; then
      echo "${EXAMPLES_SO_PATH}/libafb_model3.so: not found, using local debug directory instead"
      EXAMPLES_SO_PATH="${ROOT_DIR}/target/debug"
      if [[ ! -f "${EXAMPLES_SO_PATH}/libafb_model3.so" ]]; then
        echo "${EXAMPLES_SO_PATH}/libafb_model3.so: not found, coverage impossible"
        exit 1
      fi
    fi
  fi

  LLVM_COV_OBJECTS=(
    "${MAIN_SO_PATH}/libafb_sockcan.so"
    -object "${EXAMPLES_SO_PATH}/libafb_model3.so"
    -object "${EXAMPLES_SO_PATH}/libafb_can_multiplexing.so"
    -object "${EXAMPLES_SO_PATH}/libafb_bms.so"
  )
  LLVM_COV_IGNORE='(/\.cargo/registry/|/canbus-core-rs/|/afb-librust/|/target/)'

  # Rust coverage is generated by LLVM instrumentation. gcov cannot consume
  # Rust .profraw/.profdata, so keep llvm-cov and avoid the lcov executable.
  LCOV_OUTPUT="${COVERAGE_DIR}/lcov.info"
  "${LLVM_COV}" export \
    --format=lcov \
    --instr-profile="${COVERAGE_DIR}/merged.profdata" \
    "${LLVM_COV_OBJECTS[@]}" \
    --ignore-filename-regex="${LLVM_COV_IGNORE}" \
    > "${LCOV_OUTPUT}"

  "${LLVM_COV}" show \
    --format=html \
    --instr-profile="${COVERAGE_DIR}/merged.profdata" \
    "${LLVM_COV_OBJECTS[@]}" \
    --output-dir "${COVERAGE_DIR}/html" \
    --ignore-filename-regex="${LLVM_COV_IGNORE}"

  if ! command -v lcov_cobertura >/dev/null 2>&1; then
    if ! python3 -m lcov_cobertura --help >/dev/null 2>&1; then
      python3 -m pip install lcov_cobertura
    fi
  fi

  COBERTURA_OUTPUT="${LOG_DIR}/coverage.xml"
  lcov_cobertura "${LCOV_OUTPUT}" --output "${COBERTURA_OUTPUT}"
  echo "--- Coverage report generated at ${LOG_DIR}/ ---"
fi

##########################
# Report status
##########################

shopt -s nullglob
TAP_FILES=("${LOG_DIR}"/*.tap)
shopt -u nullglob

if [[ ${#TAP_FILES[@]} -eq 0 ]]; then
  echo "ERROR: no TAP result found in ${LOG_DIR}" >&2
  exit 1
fi

grep -viq '^not ok' "${TAP_FILES[@]}"
